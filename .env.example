# ── Market data ─────────────────────────────────────────────────────────────
# A free CoinGecko Demo key avoids most rate-limit / 403 problems (coingecko.com/en/api).
COINGECKO_API_KEY=
COINGECKO_PLAN=demo          # demo | pro   (pro also unlocks 1s/15s/30s candles)

# ── Execution ───────────────────────────────────────────────────────────────
RPC_URL=https://api.mainnet-beta.solana.com   # use a paid RPC for live trading
JUPITER_BASE_URL=https://lite-api.jup.ag/swap/v1
JUPITER_API_KEY=

# ── Live trading (leave these alone until you have backtested AND paper-traded) ──
# Live mode needs BOTH execution.mode: live in your config AND LIVE_TRADING=true here.
LIVE_TRADING=false
WALLET_KEYPAIR_PATH=./keys/bot-wallet.json    # a DEDICATED hot wallet; never commit it
